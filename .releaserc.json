{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": "dev"
    },
    {
      "name": "mvp",
      "prerelease": "mvptest"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bunx elbert-plugin version ${nextRelease.version} && bash tool/build_runtime.sh ${nextRelease.version} && bash tool/android/build_pack.sh ${nextRelease.version} && bun run build && bun run pack"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["elbert-plugin.json"],
        "message": "ci(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/*.elbx",
            "label": "Elbert plugin (.elbx)"
          },
          {
            "path": "release/android/*.apk",
            "label": "Android runtime pack (installed by Elbert on first use)"
          },
          {
            "path": "release/runtime/*.tar.gz",
            "label": "Runtime pack (downloaded by the plugin)"
          }
        ]
      }
    ]
  ]
}
