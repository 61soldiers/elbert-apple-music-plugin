{
  "id": "io.github.61soldiers.elbert.apple-music",
  "name": "Apple Music",
  "version": "2.6.0",
  "apiVersion": 1,
  "description": "Stream, download and browse your Apple Music subscription through Orchard, a self-hosted server that signs in as you.",
  "author": "61soldiers",
  "icon": "music-4",
  "entry": "plugin.js",
  "ui": {
    "common": "ui/common.rfwtxt",
    "home": "ui/home.rfwtxt",
    "search": "ui/search.rfwtxt",
    "library": "ui/library.rfwtxt",
    "playlists": "ui/playlists.rfwtxt",
    "library_playlist": "ui/library_playlist.rfwtxt",
    "detail": "ui/detail.rfwtxt",
    "artist": "ui/artist.rfwtxt",
    "replay": "ui/replay.rfwtxt",
    "wrapped": "ui/wrapped.rfwtxt",
    "downloads": "ui/downloads.rfwtxt",
    "settings": "ui/settings.rfwtxt",
    "privacy": "ui/privacy.rfwtxt"
  },
  "permissions": [
    "network",
    "storage",
    "process",
    "player",
    "library",
    "playlists",
    "lyrics",
    "history"
  ],
  "platforms": [
    "linux",
    "windows",
    "macos",
    "android"
  ],
  "android": {
    "runtimePackages": [
      "io.github.soldiers61.elbert.applemusic.runtime"
    ],
    "runtimePacks": [
      {
        "package": "io.github.soldiers61.elbert.applemusic.runtime",
        "url": "https://github.com/61soldiers/elbert-apple-music-plugin/releases/download/v2.6.0/apple-music-runtime-2.6.0.apk",
        "sha256": "71376f1bcafe2c9aa21f880987167b3f039f2cf03ab6b930b12652c62fc1b39a",
        "versionCode": 29900180
      }
    ]
  },
  "migrate": {
    "settingsKeys": [
      "orchardEnabled",
      "orchardServerUrl",
      "orchardManaged",
      "orchardPlayHistoryEnabled"
    ],
    "secureKeys": [
      "orchard_api_key"
    ],
    "playlistLinks": true,
    "legacySources": [
      "appleMusic"
    ]
  }
}
