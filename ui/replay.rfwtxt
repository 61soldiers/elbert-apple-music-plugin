// Apple Music Replay: a year, any month, or all time (the Replay tab), drawn
// as ReplayBodyView from `data.body`, built by replayBody() in
// src/pages/replay.ts. The Wrapped story is its own page (wrapped.rfwtxt).

import core;
import material;
import elbert;

widget ReplayPage = SectionScaffold(
  tabs: data.tabs,
  current: data.current,
  title: "Replay",
  child: switch data.status {
    "loading": Loader(),
    "error": ErrorView(message: data.error),
    "empty": EmptyState(
      icon: "chart-no-axes-column",
      title: "No Replay yet",
      text: "Apple builds a Replay once the account has listening history. Elbert's own statistics are under Statistics in the sidebar.",
    ),
    default: Column(
      crossAxisAlignment: "stretch",
      children: [
        PageInset(
          desktop: 16.0,
          bottom: 8.0,
          child: Wrap(
            spacing: 12.0,
            runSpacing: 8.0,
            crossAxisAlignment: "center",
            children: [
              Segmented(options: data.modes, selected: data.mode, onSelect: event "setMode" {}),
              // On a phone the unit switch sits under the hero instead of stacking another row up here.
              switch data.layout.mobile {
                true: SizedBox(),
                default: Segmented(options: data.units, selected: data.unit, onSelect: event "setUnit" {}),
              },
            ],
          ),
        ),
        switch data.hasYears {
          true: PageInset(desktop: 16.0, bottom: 8.0, child: ChipPicker(options: data.years, selected: data.selected, onSelect: event "select" {})),
          default: SizedBox(),
        },
        switch data.hasMonthPicker {
          true: PageInset(desktop: 16.0, bottom: 8.0, child: ChipPicker(options: data.monthOptions, selected: data.selectedMonth, onSelect: event "selectMonth" {})),
          default: SizedBox(),
        },
        // Its own clip: the pickers above are part of the page, so without one
        // the summary scrolls up over them.
        Expanded(child: BleedClip(child: ReplayBodyView())),
      ],
    ),
  },
);

widget ReplayBodyView = switch data.bodyStatus {
  "loading": Loader(),
  "error": ErrorView(message: data.bodyError, back: false),
  default: Stagger(
    durationMs: 900,
    restartKey: data.body.summaryId,
    child: ScrollPage(
      topInset: false,
      bleed: true,
      refreshEvent: "refresh",
      slivers: [
        SliverBox(
          child: SlideIn(
            delayMs: 60,
            child: PageInset(
              desktop: 20.0,
              top: 4.0,
              bottom: 20.0,
              child: StatHero(caption: data.body.hero.caption, value: data.body.hero.value, unit: data.body.hero.unit, note: data.body.hero.note),
            ),
          ),
        ),
        switch data.layout.mobile {
          true: SliverBox(
            child: PageInset(
              desktop: 20.0,
              bottom: 16.0,
              child: Row(
                children: [
                  ThemedText(text: "Time in", style: "labelLarge", color: "onSurfaceVariant"),
                  SizedBox(width: 12.0),
                  Segmented(options: data.units, selected: data.unit, onSelect: event "setUnit" {}),
                ],
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.hasWrapped {
          true: SliverBox(
            child: SlideIn(
              delayMs: 100,
              child: PageInset(
                desktop: 20.0,
                bottom: 16.0,
                child: LinkCard(icon: "sparkles", title: data.wrappedLabel, subtitle: "Scroll through your listening, animated", onTap: event "wrapped" {}),
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasCounts {
          true: SliverBox(child: SlideIn(delayMs: 120, child: PageInset(desktop: 20.0, bottom: 28.0, child: CountTiles(tiles: data.body.counts)))),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasHighlights {
          true: SliverBox(
            child: SlideIn(
              delayMs: 150,
              child: PageInset(
                desktop: 20.0,
                bottom: 28.0,
                child: Surface(
                  tone: "low",
                  child: Column(
                    crossAxisAlignment: "start",
                    children: [
                      ...for h in data.body.highlights: Padding(padding: [0.0, 4.0], child: StatusLine(icon: h.icon, tone: "primary", text: h.text)),
                    ],
                  ),
                ),
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasPlaylist {
          true: SliverBox(
            child: SlideIn(
              delayMs: 180,
              child: PageInset(
                desktop: 20.0,
                bottom: 28.0,
                child: LinkCard(icon: "list-music", title: data.body.playlistName, subtitle: "Apple's playlist of your most played", onTap: event "playlist" {}),
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasBars {
          true: ReplaySection(
            delayMs: 240,
            title: data.body.barsTitle,
            child: PageInset(
              desktop: 20.0,
              child: BarChart(bars: data.body.bars, caption: data.body.barsCaption, animationKey: data.body.summaryId, onTap: event "bar" {}),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasNote {
          true: SliverBox(
            child: SlideIn(
              delayMs: 240,
              child: PageInset(desktop: 20.0, bottom: 28.0, child: NoteCard(title: data.body.noteTitle, text: data.body.noteText)),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasArtists {
          true: ReplaySection(delayMs: 300, title: "Top artists", child: ReplayRail(items: data.body.artists, rail: "artists")),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasSongs {
          true: ReplaySection(
            delayMs: 360,
            title: data.body.songsTitle,
            child: Column(
              crossAxisAlignment: "stretch",
              children: [
                switch data.body.hasSongsNote {
                  true: PageInset(desktop: 20.0, bottom: 12.0, child: NoteCard(icon: "clock", title: "Play counts can lag", text: data.body.songsNote)),
                  default: SizedBox(),
                },
                RankList(
                  items: data.body.songs,
                  padding: switch data.layout.mobile { true: 0.0, default: 20.0 },
                  onTap: event "open" { rail: "songs" },
                ),
              ],
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasAlbums {
          true: ReplaySection(delayMs: 420, title: "Top albums", child: ReplayRail(items: data.body.albums, rail: "albums")),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasGenres {
          true: ReplaySection(delayMs: 480, title: "Top genres", child: PageInset(desktop: 20.0, child: ShareBars(items: data.body.genres))),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasPlaylists {
          true: ReplaySection(delayMs: 540, title: "Top playlists", child: ReplayRail(items: data.body.playlists, rail: "playlists")),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasStations {
          true: ReplaySection(delayMs: 600, title: "Top stations", child: ReplayRail(items: data.body.stations, rail: "stations")),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasMilestones {
          true: ReplaySection(
            delayMs: 660,
            title: "Milestones",
            child: BadgeRail(items: data.body.milestones, padding: switch data.layout.mobile { true: 0.0, default: 20.0 }),
          ),
          default: SliverGap(height: 0.0),
        },
        // ---- "In Elbert": the detail Apple doesn't rank, from Elbert's own history ----
        switch data.body.hasDetail {
          true: ReplaySection(
            delayMs: 700,
            title: "In Elbert",
            child: PageInset(
              desktop: 20.0,
              child: Column(
                crossAxisAlignment: "stretch",
                children: [
                  ThemedText(text: "Apple Music plays Elbert logged: streamed here, or imported from Apple's data export. Separate from Apple's own figures above.", style: "bodyMedium", color: "onSurfaceVariant"),
                  SizedBox(height: 10.0),
                  ThemedText(text: data.body.detail.caption, style: "titleMedium", weight: 700, color: "primary"),
                  switch data.body.detail.hasBars {
                    true: Padding(padding: [0.0, 14.0, 0.0, 0.0], child: BarChart(bars: data.body.detail.bars, caption: data.body.detail.barsCaption, animationKey: data.body.summaryId)),
                    default: SizedBox(),
                  },
                ],
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.hasDetailEmpty {
          true: SliverBox(
            child: SlideIn(
              delayMs: 700,
              child: PageInset(
                desktop: 20.0,
                bottom: 28.0,
                child: NoteCard(
                  icon: "history",
                  title: "Nothing logged in Elbert",
                  text: data.body.detailEmpty,
                  buttonLabel: "Import play activity",
                  buttonIcon: "file-up",
                  onPressed: event "importPlays" {},
                ),
              ),
            ),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.detail.hasArtists {
          true: ReplaySection(
            delayMs: 740,
            title: "Top artists in Elbert",
            child: RankList(items: data.body.detail.artists, collapsed: 5, padding: switch data.layout.mobile { true: 0.0, default: 20.0 }, onTap: event "open" { rail: "detailArtists" }),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.detail.hasAlbums {
          true: ReplaySection(
            delayMs: 780,
            title: "Top albums in Elbert",
            child: RankList(items: data.body.detail.albums, collapsed: 5, padding: switch data.layout.mobile { true: 0.0, default: 20.0 }, onTap: event "open" { rail: "detailAlbums" }),
          ),
          default: SliverGap(height: 0.0),
        },
        switch data.body.detail.hasSongs {
          true: ReplaySection(
            delayMs: 820,
            title: "Top songs in Elbert",
            child: RankList(items: data.body.detail.songs, collapsed: 10, padding: switch data.layout.mobile { true: 0.0, default: 20.0 }, onTap: event "open" { rail: "detailSongs" }),
          ),
          default: SliverGap(height: 0.0),
        },
      ],
    ),
  ),
};

// A titled block of the body, as a sliver.
widget ReplaySection = SliverBox(
  child: SlideIn(
    delayMs: args.delayMs,
    child: Padding(
      padding: [0.0, 0.0, 0.0, 28.0],
      child: Column(
        crossAxisAlignment: "stretch",
        children: [
          PageInset(
            desktop: 20.0,
            bottom: 14.0,
            child: ThemedText(text: args.title, style: "headlineSmall", weight: 700, size: 21.0),
          ),
          args.child,
        ],
      ),
    ),
  ),
);

widget ReplayRail = CardRail(
  size: "replay",
  innerPadding: switch data.layout.mobile { true: 0.0, default: 20.0 },
  items: args.items,
  onTap: event "open" { rail: args.rail },
);
