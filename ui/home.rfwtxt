// The Apple Music Home tab — or, until a session is ready, the setup flow.

import core;
import material;
import elbert;
import common;

widget HomePage = switch data.mode {
  "ready": HomeContent(),
  default: SetupFlow(setup: data.setup),
};

widget HomeContent = Stagger(
  durationMs: 700,
  child: ScrollPage(
    bleed: true,
    refreshEvent: "refresh",
    slivers: [
      SliverBox(
        child: SlideIn(
          delayMs: 0,
          child: Padding(
            padding: [0.0, 0.0, 0.0, 20.0],
            child: Row(
              children: [
                ThemedIcon(name: "music-4", color: "primary", size: 26.0),
                SizedBox(width: 10.0),
                Expanded(child: ThemedText(text: "Apple Music", style: "headlineMedium", weight: 700, size: 28.0)),
                switch data.layout.mobile {
                  true: IconButton(icon: "folder-down", tooltip: "Downloads", badge: data.tabs.4.badge, onPressed: event "downloads" {}),
                  default: SizedBox(),
                },
              ],
            ),
          ),
        ),
      ),
      SliverBox(
        child: SlideIn(
          delayMs: 40,
          child: Padding(
            padding: [0.0, 0.0, 0.0, 20.0],
            child: switch data.layout.mobile {
              true: Align(
                alignment: { x: -1.0, y: 0.0 },
                child: Button(variant: "chip", icon: "arrow-left", label: "Your library", onPressed: event "library" {}),
              ),
              default: SubNav(tabs: data.tabs, current: data.current),
            },
          ),
        ),
      ),
      SliverBox(
        child: switch data.recsStatus {
          "loading": Loader(expand: false, height: 132.0),
          "error": Message(text: data.recsError, color: "error"),
          default: SlideIn(
            delayMs: 80,
            child: switch data.hasHero {
              true: HeroStrip(hero: data.hero, pins: data.pins, onHero: event "hero" {}, onPin: event "pin" {}),
              default: switch data.layout.mobile {
                true: SizedBox(),
                default: HeroStrip(pins: data.pins, onPin: event "pin" {}),
              },
            },
          ),
        },
      ),
      SliverGap(height: 28.0),
      SliverBox(
        child: switch data.hasGroups {
          true: SlideIn(
            delayMs: 140,
            child: Column(
              crossAxisAlignment: "stretch",
              children: [
                Padding(padding: [0.0, 0.0, 0.0, 14.0], child: ThemedText(text: "Made For You", style: "headlineSmall", weight: 700, size: 22.0)),
                CardRail(size: "home", items: data.groups, onTap: event "group" {}),
              ],
            ),
          ),
          default: SizedBox(),
        },
      ),
      SliverGap(height: 28.0),
      SliverBox(
        child: SlideIn(
          delayMs: 200,
          child: Padding(padding: [0.0, 0.0, 0.0, 14.0], child: ThemedText(text: "Recently Played", style: "headlineSmall", weight: 700, size: 22.0)),
        ),
      ),
      SliverBox(
        child: switch data.recentStatus {
          "loading": Loader(expand: false, height: 220.0),
          "error": Message(text: data.recentError, color: "error"),
          "empty": Surface(
            tone: "low",
            child: SizedBox(
              height: 180.0,
              child: Center(child: ThemedText(text: "Nothing played recently.", style: "bodyMedium", color: "onSurfaceVariant")),
            ),
          ),
          default: CardRail(size: "home", items: data.recent, onTap: event "recent" {}),
        },
      ),
    ],
  ),
);
