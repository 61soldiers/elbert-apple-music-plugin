// One of the account's library playlists: the page that can edit it.

import core;
import material;
import elbert;

widget LibraryPlaylistPage = switch data.status {
  "loading": Loader(),
  "error": ErrorView(message: data.error),
  default: Stagger(
    durationMs: 500,
    child: ScrollPage(
      topInset: false,
      bottomInset: "dock",
      slivers: [
        // Rename / Edit order / Sync / Delete are the header's ⋯ menu; a
        // read-only playlist sends none, so it has no menu.
        StickyHeader(
          title: data.title,
          subtitle: data.subtitle,
          type: "PLAYLIST",
          cover: data.cover,
          info: data.info,
          expanded: 450.0,
          menu: data.actions,
          onMenu: event "action" {},
          onPlayAll: event "play" { index: 0 },
          onShuffle: event "shuffle" {},
        ),
        SliverBox(
          child: Padding(
            padding: [16.0, 20.0, 16.0, 0.0],
            child: SlideIn(
              delayMs: 150,
              child: Column(
                crossAxisAlignment: "start",
                children: [
                  Wrap(
                    spacing: 12.0,
                    runSpacing: 12.0,
                    children: [
                      Button(
                        icon: "download",
                        label: "Download all",
                        busy: data.busy,
                        disabled: switch data.hasTracks { true: false, default: true },
                        onPressed: event "downloadAll" {},
                      ),
                      switch data.editing {
                        true: Button(variant: "tonalFilled", icon: "circle-check", label: "Done reordering", onPressed: event "toggleEditing" {}),
                        default: SizedBox(),
                      },
                    ],
                  ),
                  switch data.hasDescription {
                    true: Padding(
                      padding: [0.0, 14.0, 0.0, 16.0],
                      child: ExpandableText(text: data.description, maxWidth: 640.0),
                    ),
                    default: SizedBox(),
                  },
                ],
              ),
            ),
          ),
        ),
        switch data.editing {
          true: SliverBox(
            child: Padding(
              padding: [16.0, 16.0, 16.0, 0.0],
              child: ReorderableTrackList(
                items: data.editItems,
                removeLabel: "Remove from playlist",
                onReorder: event "reorder" {},
                onRemove: event "remove" {},
              ),
            ),
          ),
          default: TrackList(
            items: data.tracks,
            hasMore: data.hasMore,
            onLoadMore: event "more" {},
            onPlay: event "play" {},
            onMenu: event "menu" {},
          ),
        },
        SliverGap(height: 12.0),
      ],
    ),
  ),
};
